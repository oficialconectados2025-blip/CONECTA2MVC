@{
    ViewData["Title"] = "Página Inicial";
}

@section Estilos {
    <!-- Estilo para la landing page (tu CSS que estaba en ./assets/css/l_page.css) -->
    <link rel="stylesheet" href="~/css/l_page.css" asp-append-version="true" />
}

<!-- INTRO con la primera imagen de spline -->
<div id="intro-screen">
    <spline-viewer class="intro-viewer"
                   url="https://prod.spline.design/1NUOg6CDf21UPI-7/scene.splinecode">
    </spline-viewer>
</div>

<!-- LANDING PAGE con la segunda imagen de fondo -->
<div id="landing-screen">
    <spline-viewer class="bg-viewer"
                   url="https://prod.spline.design/R27l3FGRDoVCJXm5/scene.splinecode">
    </spline-viewer>

    @* En vez de tutorials.html, usamos ruta MVC *@
    <a class="btn-start"id="btn-start" href="@Url.Action("Index","Tutorial")">COMENZAR</a>
</div>

@section Scripts {
    <!-- Spline viewer -->
    <script type="module" src="https://unpkg.com/@@splinetool/viewer@1.12.3/build/spline-viewer.js"></script>

    <!-- Código JavaScript para la landing -->
    <script src="~/js/l_page.js" asp-append-version="true"></script>
}
